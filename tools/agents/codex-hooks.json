{
  "description": "Show Codex approvals on the HelloCubic status display",
  "hooks": {
    "PermissionRequest": [ { "hooks": [ { "type": "command", "command": "$HOME/.local/bin/cube-hook.sh codex 2>/dev/null || true", "async": true, "timeout": 5 } ] } ],
    "PostToolUse": [ { "hooks": [ { "type": "command", "command": "$HOME/.local/bin/cube-hook.sh codex 2>/dev/null || true", "async": true, "timeout": 5 } ] } ],
    "UserPromptSubmit": [ { "hooks": [ { "type": "command", "command": "$HOME/.local/bin/cube-hook.sh codex 2>/dev/null || true", "async": true, "timeout": 5 } ] } ],
    "Stop": [ { "hooks": [ { "type": "command", "command": "$HOME/.local/bin/cube-hook.sh codex 2>/dev/null || true", "async": true, "timeout": 5 } ] } ],
    "SessionEnd": [ { "hooks": [ { "type": "command", "command": "$HOME/.local/bin/cube-hook.sh codex 2>/dev/null || true", "async": true, "timeout": 5 } ] } ]
  }
}
